    <string name="tutorial_step_format">Step %1$d of %2$d</string>
    <string name="tutorial_dice_step1_title">Select your dice</string>
    <string name="tutorial_dice_step1_message">Tap the dice in the storage to move them to the selection zone.</string>
    <string name="tutorial_dice_step2_title">Adjust your selection</string>
    <string name="tutorial_dice_step2_message">If you want to remove a die, tap it in the selection zone to return it.</string>
    <string name="tutorial_dice_step3_title">Start game</string>
    <string name="tutorial_dice_step3_message">When you are ready, tap “Start game” to begin.</string>
    <string name="tutorial_deck_step1_title">Select cards</string>
    <string name="tutorial_deck_step1_message">Tap cards to build your deck (30–40). At the top left you can see how many cards you have and at the top right how many you have selected.</string>
    <string name="tutorial_deck_step2_title">Create your deck</string>
    <string name="tutorial_deck_step2_message">Tap Create, enter a name, and confirm to save your deck.</string>
    <string name="tutorial_deck_step3_title">Manage decks</string>
    <string name="tutorial_deck_step3_message">Use Load or Delete to manage your saved decks.</string>
    <string name="tutorial_accept">Accept</string>
    <string name="tutorial_game_loop_step1_title">Goals and game loop</string>
    <string name="tutorial_game_loop_step1_message">The goal of the game is to capture as many fish as possible through strategic dice placement.</string>
    <string name="tutorial_game_loop_step2_title">Roll a die</string>
    <string name="tutorial_game_loop_step2_message">To start the game you must roll a die. Select a die to roll.</string>
    <string name="tutorial_game_loop_step3_title">Place the die</string>
    <string name="tutorial_game_loop_step3_message">Select the space in the fishing zone where you want to place the die.</string>
    <string name="tutorial_game_loop_step4_title">Reveal the card</string>
    <string name="tutorial_game_loop_step4_message">When you place a die on a card, it flips and can trigger abilities and show capture requirements. To see details, long-press the card.</string>
    <string name="tutorial_game_loop_step5_title">Capture attempt</string>
    <string name="tutorial_game_loop_step5_message">We will attempt to capture the card. Roll a new die and place it on a card that already has a die. If you meet the capture condition the card is yours; otherwise you must select a die to discard.</string>
    <string name="tutorial_release_step1_title">Release a card</string>
    <string name="tutorial_release_step1_message">You can release a card to the fishing zone to reuse its abilities. Click the card you want to release.</string>
    <string name="tutorial_release_step2_title">Choose where to release</string>
    <string name="tutorial_release_step2_message">You can select where in the fishing zone to release the card.</string>
    <string name="tutorial_tide_step1_title">Tides</string>
    <string name="tutorial_tide_step1_message">The tide activates if a die rolls 1 and drags all cards upward; dice that leave the game due to the tide will be lost. To pass the tutorial just tap the screen to continue.</string>

