<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@drawable/menu_background_start"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/menu_glass_panel"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:text="Pezcard"
            android:textSize="35sp"
            style="@style/App.Text.Title.Ocean" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/startNewGame"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="1dp"
            android:background="@drawable/botonnuevojuego"
            android:text="Nuevo juego"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:padding="0dp"/>


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/openDiceShop"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="0dp"
            android:background="@drawable/botontienda"
            android:text="Tienda"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:padding="0dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/openSettings"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="0dp"
            android:background="@drawable/botonconfiguracion"
            android:text="Configuración"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:padding="0dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/openCollections"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="0dp"
            android:background="@drawable/botoncoleccion"
            android:text="Colección"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:padding="0dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/openRanking"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="0dp"
            android:background="@drawable/botonrecord"
            android:text="Clasificación"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:padding="0dp"/>
        <TextView
            android:id="@+id/scoreRecordsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Records de puntaje"
            style="@style/App.Text.Title.Ocean.Sub" />

        <ListView
            android:id="@+id/scoreRecordsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@android:color/darker_gray"
            android:dividerHeight="1dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:scrollbars="none"
            tools:listitem="@android:layout/simple_list_item_1" />

        <TextView
            android:id="@+id/scoreRecordsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aún no hay puntajes registrados"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@android:color/darker_gray"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
