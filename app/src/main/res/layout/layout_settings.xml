<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/menu_background_start"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_glass_panel"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/settingsTitle"
                style="@style/App.Text.Title.Ocean"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_title" />

            <LinearLayout
                android:id="@+id/settingsUserSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/section_panel"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/settingsUserHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/settingsUserTitle"
                        style="@style/App.Text.Title.Ocean.Sub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_user_title" />

                    <ImageView
                        android:id="@+id/settingsUserChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/settings_section_toggle"
                        android:rotation="180"
                        android:src="@android:drawable/arrow_down_float" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/settingsUserContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/settingsRankingTitle"
                        style="@style/App.Text.Title.Ocean.Sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_ranking_title" />

                    <TextView
                        android:id="@+id/settingsRankingNameLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_ranking_name_label" />

                    <EditText
                        android:id="@+id/settingsRankingNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:hint="@string/settings_ranking_name_hint"
                        android:inputType="text"
                        android:maxLength="7" />

                    <TextView
                        android:id="@+id/settingsRankingCountryLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_ranking_country_label" />

                    <Spinner
                        android:id="@+id/settingsRankingCountrySpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/settingsRankingSave"
                        style="@style/App.Button.Glass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/settings_ranking_save" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsLanguageSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/section_panel"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/settingsLanguageHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/settingsLanguageTitle"
                        style="@style/App.Text.Title.Ocean.Sub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_language_title" />

                    <ImageView
                        android:id="@+id/settingsLanguageChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/settings_section_toggle"
                        android:rotation="0"
                        android:src="@android:drawable/arrow_down_float" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/settingsLanguageContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/settingsLanguageTextTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_language_texts_title" />

                    <ListView
                        android:id="@+id/settingsLanguageList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:choiceMode="singleChoice"
                        android:divider="@android:color/transparent"
                        android:dividerHeight="8dp"
                        android:listSelector="@color/selection_highlight" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsAudioSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/section_panel"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/settingsAudioHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/settingsAudioTitle"
                        style="@style/App.Text.Title.Ocean.Sub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_audio_title" />

                    <ImageView
                        android:id="@+id/settingsAudioChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/settings_section_toggle"
                        android:rotation="180"
                        android:src="@android:drawable/arrow_down_float" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/settingsAudioContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/settingsMusicLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/settings_music_volume" />

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/settingsMusicToggle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_audio_toggle" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/settingsMusicVolume"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="100" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/settingsSfxLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/settings_sfx_volume" />

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/settingsSfxToggle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_audio_toggle" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/settingsSfxVolume"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="100" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/settingsButtonLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/settings_button_volume" />

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/settingsButtonToggle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_audio_toggle" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/settingsButtonVolume"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="100" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsTutorialsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/section_panel"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/settingsTutorialsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/settingsTutorialsTitle"
                        style="@style/App.Text.Title.Ocean.Sub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_tutorials_title" />

                    <ImageView
                        android:id="@+id/settingsTutorialsChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/settings_section_toggle"
                        android:rotation="0"
                        android:src="@android:drawable/arrow_down_float" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/settingsTutorialsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/settingsTutorialDiceToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_tutorial_dice" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/settingsTutorialDeckToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_tutorial_deck" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/settingsTutorialGameLoopToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_tutorial_game_loop" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/settingsTutorialReleaseToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_tutorial_release" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/settingsTutorialTideToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_tutorial_tide" />
                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/settingsBack"
                android:layout_width="150dp"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/botonvolver"
                android:gravity="center_vertical"
                android:padding="10dp"
                android:text="@string/back"
                android:textAllCaps="false"
                android:textColor="@android:color/black"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</ScrollView>
