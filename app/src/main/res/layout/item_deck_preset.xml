<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/deckPresetCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/marine_foam"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/marine_turquoise"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="7dp">

        <ImageView
            android:id="@+id/deckPresetImage"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/deck_management_icon_description"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/deckPresetName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
            android:textColor="@color/marine_deep" />

        <TextView
            android:id="@+id/deckPresetDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/marine_deep" />

        <TextView
            android:id="@+id/deckPresetSelected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="@drawable/dice_zone_label_background"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="@string/deck_management_selected"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:textColor="@color/marine_deep"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
