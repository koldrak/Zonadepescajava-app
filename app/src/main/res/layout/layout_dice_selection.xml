<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/menu_background_dice_selection"
    tools:context=".MainActivity">
    <ScrollView
        android:id="@+id/dadosScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/menu_glass_panel"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="20dp">

    <TextView
        android:id="@+id/diceSelectionInstruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        style="@style/App.Text.Title.Ocean.Sub"
        android:text="@string/dice_selection_instruction"
        android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />

    <FrameLayout
        android:id="@+id/diceSelectionZone"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/dice_selection_zone_background"
        android:padding="12dp">

        <ScrollView
            android:id="@+id/diceSelectionScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="24dp"
            android:clipToPadding="false">

            <GridLayout
                android:id="@+id/diceSelectionGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4" />
        </ScrollView>

        <TextView
            android:id="@+id/diceSelectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:layout_margin="8dp"
            android:background="@drawable/dice_zone_label_background"
            android:text="@string/dice_selection_zone_label"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="@color/marine_deep" />
    </FrameLayout>

    <TextView
        android:id="@+id/diceSelectionCounter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        style="@style/App.Text.Title.Ocean.Sub"
        android:text="@string/dice_selection_counter_placeholder"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <FrameLayout
            android:id="@+id/diceWarehouseZone"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/dice_warehouse_zone_background"
            android:padding="12dp">

            <ScrollView
                android:id="@+id/diceWarehouseScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="24dp">

                <GridLayout
                    android:id="@+id/diceWarehouseGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4" />
            </ScrollView>

            <TextView
                android:id="@+id/diceWarehouseLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|top"
                android:layout_margin="8dp"
                android:background="@drawable/dice_zone_label_background"
                android:text="@string/dice_warehouse_zone_label"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="@color/marine_deep" />
        </FrameLayout>

        <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/openDeckSelection"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="1dp"
            android:background="@drawable/botoncrearmazo"
            android:text="              Crear mazo"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:gravity= "fill_vertical"
            android:padding="0dp"/>

        <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/confirmDiceSelection"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="1dp"
            android:background="@drawable/botonnuevojuego"
            android:text="            Iniciar Partida"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:gravity="fill_vertical"
            android:padding="0dp"/>

    </LinearLayout>
    </ScrollView>
</LinearLayout>
