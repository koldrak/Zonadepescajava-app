<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/menu_background_collections"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/menu_glass_panel"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/deckSelectionTitle"
            style="@style/App.Text.Title.Ocean"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/deck_selection_create_title" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/deck_selection_name_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/deckSelectionName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences"
                android:maxLength="28"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/deckSelectionCount"
                style="@style/App.Text.Title.Ocean.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/deck_selection_count_placeholder" />

            <TextView
                android:id="@+id/deckSelectionScore"
                style="@style/App.Text.Title.Ocean.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/deck_selection_score_placeholder" />
        </LinearLayout>

        <TextView
            android:id="@+id/deckSelectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/deck_selection_status_missing_format"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/marine_deep" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/deckSelectionFilterGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/deckSelectionFilterAll"
                    style="@style/App.Button.Glass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_all" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/deckSelectionFilterOrange"
                    style="@style/App.Button.Glass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/filter_orange_cards" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/deckSelectionFilterGreen"
                    style="@style/App.Button.Glass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/filter_green_cards" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/deckSelectionFilterBlue"
                    style="@style/App.Button.Glass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/filter_blue_cards" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/deckSelectionFilterBlack"
                    style="@style/App.Button.Glass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/filter_black_cards" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/deckSelectionRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="8dp"
            tools:listitem="@layout/item_deck_selection_card" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deckSelectionBack"
                style="@style/App.Button.Glass"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/back" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deckSelectionDelete"
                style="@style/App.Button.Glass"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/deck_selection_delete"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deckSelectionSave"
                style="@style/App.Button.Watercolor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1.35"
                android:text="@string/deck_selection_save_and_use" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
